# 数据库连接（PostgreSQL）
# 本地开发：postgresql://user:password@localhost:5432/investrack
# 腾讯云生产：postgresql://user:password@tg-db-postgres.sql.tencentcdb.com:port/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/investrack"

# NextAuth 配置
# 生成强随机密钥：openssl rand -base64 32
NEXTAUTH_SECRET=""

# 生产环境设为实际 HTTPS 域名；HTTP 公网 IP 部署时设为 http://<IP>
NEXTAUTH_URL="http://localhost:3000"

# DeepSeek API Key（融资热点分析、新闻监控、竞争态势分析、AI 卡片、竞争态势分析）
DEEPSEEK_API_KEY=""

# Tavily API Key（AI 线索检索、投研分析联网搜索、文档全文提取）
TAVILY_API_KEY=""

# 定时任务密钥（用于 cron API 鉴权，避免外部随意触发）
# 生成强随机密钥：openssl rand -hex 32
# 配合 crontab 调用 /api/cron/ai-leads-retrieval 和 /api/cron/release-leads
CRON_SECRET=""

# 腾讯云 COS 配置（头像/文档上传，可选；不配置则回退到本地 public/ 目录）
# COS_SECRET_ID=""
# COS_SECRET_KEY=""
# COS_BUCKET=""
# COS_REGION="ap-guangzhou"
