generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String    @id @default(cuid())
  name             String
  companyFullName  String?
  industry         String?
  companyPosition  String?
  mainProducts     String?
  financialData    String?
  orderProgress    String?
  financingPlan    String?
  financingRound   String?
  followStage      String    @default("INITIAL_TALK")
  coreAdvantage    String?
  coreTeam         String?
  competitors      String?
  competitorAnalysisJson String?
  description      String?
  status           String    @default("PENDING")
  totalAmount      String   // 融资金额（用户自填单位，如"500万"、"2亿"）
  raisedAmount     String   @default("")  // 历史累计融资金额（用户自填单位，如"500万"、"2亿"）
  investmentValuation Float?  // 投资估值（亿元）
  targetDate       DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String
  aiCardJson       String?
  keywords         String?
  // 投资亮点：维护人手动填写（文本，可含 markdown）
  manualHighlights String?
  // 投资亮点：AI 结合所有模块总结（JSON：{ highlights: string[], analyzedAt }）
  aiHighlightsJson String?
  // 维护人保护期到期时间：创建时 = createdAt + 3个月；接手后重置
  protectionExpiresAt DateTime?
  // 项目经过的所有阶段（JSON 数组字符串，如 ["INITIAL_TALK","PRE_DD"]）
  // 用于累计统计：进入某阶段即+1，变更到后续阶段时补齐中间阶段，不回退
  passedStages String?
  // 最近一次阶段变更时间（用于本周新增项目：本周变更阶段的项目也显示）
  stageChangedAt DateTime?
  investments      Investment[]
  investors        Investor[] @relation("InvestorProjects")
  members          ProjectMember[]
  news             ProjectNews[]
  partnerReviews   PartnerReview[]
  followUpNotes    FollowUpNote[]
  stageApprovals   StageApproval[]
  takeoverRequests TakeoverRequest[]
  stageChangeRequests StageChangeRequest[]
  documents        ProjectDocument[]
  researchModules  ResearchModule[]
  ddReport         DDReport?
  ddBatches        DDBatch[]
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([createdById])
  @@index([followStage])
  @@index([targetDate])
  @@index([stageChangedAt])
  @@index([protectionExpiresAt])
  @@index([status])
}

// 项目文档（如 BP、商业计划书等 PDF/PPT 文件，支持多个历史版本）
model ProjectDocument {
  id            String   @id @default(cuid())
  projectId     String
  fileName      String   // 原始文件名（展示用）
  fileUrl       String   // 文件访问 URL（/project-docs/xxx.pdf 或 COS URL）
  fileType      String   // MIME 类型（application/pdf, application/vnd.ms-powerpoint 等）
  fileSize      Int      // 文件大小（字节）
  uploadedById  String
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploadedById])
}

model Investment {
  id          String    @id @default(cuid())
  amount      Float
  date        DateTime @default(now())
  investorId  String
  projectId   String
  investor    Investor  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([investorId])
}

model Investor {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  phone       String?
  avatar      String?
  investments Investment[]
  projects    Project[]   @relation("InvestorProjects")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  username      String?         @unique  // 账户名（可用于登录）
  passwordHash  String
  name          String?
  avatar        String?  // 头像 URL（如 /avatars/xxx.png）
  role          String          @default("TEMP_VISITOR")
  status        String          @default("ACTIVE")  // ACTIVE / PENDING / REJECTED / DISABLED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  projects      Project[]
  projectMembers ProjectMember[]
  partnerReviews   PartnerReview[]
  followUpNotes    FollowUpNote[]
  stageApprovals   StageApproval[]
  projectLeads     ProjectLead[]
  // 接手申请：作为请求者
  takeoverRequestsInitiated TakeoverRequest[] @relation("TakeoverRequestRequester")
  // 接手申请：作为当前维护人（被请求者）
  takeoverRequestsReceived  TakeoverRequest[] @relation("TakeoverRequestOwner")
  // 阶段变更请求：作为发起者
  stageChangeRequestsInitiated StageChangeRequest[] @relation("StageChangeRequestRequester")
  // 阶段变更请求：作为审批者
  stageChangeRequestsReviewed  StageChangeRequest[] @relation("StageChangeRequestReviewer")
  // 上传的项目文档
  projectDocuments   ProjectDocument[]
  // AI检索任务日志
  aiRetrievalLogs    AIRetrievalLog[]
  // 自定义跟踪信号
  trackingSignals    TrackingSignal[]
  // 投研分析模块文档
  researchDocuments  ResearchDocument[]
  // 投研分析模块点评
  researchComments   ResearchComment[]
  // AI行研会话
  aiChatSessions     AIChatSession[]
  // 尽调批次：作为发起人
  ddBatchesInitiated DDBatch[] @relation("DDBatchInitiator")
  // 尽调模块任务：作为负责人
  ddTasksOwned       DDTask[] @relation("DDTaskOwner")
  // 尽调证据：作为创建人
  ddEvidencesCreated DDEvidence[] @relation("DDEvidenceCreator")
  // 尽调证据：作为确认人
  ddEvidencesConfirmed DDEvidence[] @relation("DDEvidenceConfirmer")
  // 尽调报告版本：作为冻结人
  ddReportVersionsFrozen DDReportVersion[] @relation("DDReportFreezer")
  // 项目解读（AI行研）：上传人
  projectInterpretations ProjectInterpretation[] @relation("ProjectInterpretations")
}

// 项目线索（用于在新建项目时进行重合检测和合并，也用于AI自动检索）
model ProjectLead {
  id               String   @id @default(cuid())
  name             String
  industry         String?  // 行业/赛道
  companyPosition  String?  // 公司定位
  mainProducts     String?  // 主要产品
  financingHistory String?  // 融资经历
  contactInfo      String?  // 联系方式
  description      String?  // 备注
  status           String   @default("PENDING") // PENDING / CONVERTED / ARCHIVED
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ── AI 自动检索扩展字段 ──
  source           String   @default("MANUAL") // MANUAL / AI
  fundingRound     String?  // 融资轮次（如 A轮、B轮）
  fundingAmount    String?  // 融资金额（文本，如"5000万元"）
  valuation        String?  // 估值（文本）
  investors        String?  // 投资机构（JSON数组字符串）
  financialAdvisors String? // 财务顾问（JSON数组字符串）
  coreAdvantage    String?  // 核心优势
  sourceUrl        String?  // 原文链接
  sourceTitle      String?  // 原文标题
  matchedProjectId String?  // 匹配的初聊项目ID
  matchedConfidence Float?  // 匹配置信度 0-1
  releasedAt       DateTime? // 释放时间（两周后自动释放，null=仅维护人可见）
  aiSummary        String?  // AI生成的摘要
  // 来源跟踪信号（自定义信号执行结果的标记）
  signalId         String?  // 关联 TrackingSignal.id
  signalName       String?  // 冗余信号名（展示用）

  @@index([name])
  @@index([createdById])
  @@index([source])
  @@index([status])
  @@index([matchedProjectId])
  @@index([releasedAt])
  @@index([signalId])
}

// 自定义跟踪信号（AI线索页配置：自然语言生成，按频率自动执行跟踪）
model TrackingSignal {
  id            String    @id @default(cuid())
  name          String    // 信号名称（如"大厂核心成员离职跟踪"）
  description   String    // 用户自然语言描述（原始输入）
  signalType    String    @default("CUSTOM") // PERSONNEL_CHANGE / NEW_STARTUP / TECH_BREAKTHROUGH / FUNDING / CUSTOM
  keywords      String    // 搜索关键词（JSON 数组字符串，1-3 组）
  watchTargets  String?   // 监控对象（JSON 数组字符串：公司/人物名，可空）
  industry      String?   // 关联行业（可选）
  frequency     String    @default("WEEKLY") // DAILY / WEEKLY
  isActive      Boolean   @default(true)
  lastRunAt     DateTime? // 上次执行时间
  lastRunCount  Int       @default(0) // 上次执行新发现的线索数
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, frequency])
  @@index([createdById])
}

// AI 检索任务执行日志
model AIRetrievalLog {
  id            String   @id @default(cuid())
  status        String   @default("RUNNING") // RUNNING / COMPLETED / FAILED
  keywords      String?  // 检索关键词（JSON字符串）
  foundCount    Int      @default(0) // 发现的线索数量
  savedCount    Int      @default(0) // 保存的线索数量
  error         String?  // 错误信息
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  triggeredById String?  // 触发者ID（null表示定时任务自动触发）
  triggeredBy   User?    @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startedAt])
}

// AI 分析结果缓存（融资热点图等共享数据）
model AICache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique  // 如 "heatmap:2026"、"news:2026-W30"
  data      String            // JSON 字符串
  updatedAt DateTime @default(now()) @updatedAt

  @@index([cacheKey])
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProjectNews {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  source         String?
  url            String
  summary        String?
  analysisType   String   @default("UNKNOWN")
  analysisDetail String?
  publishedAt    DateTime
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model PartnerReview {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  userName  String
  content   String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model FollowUpNote {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  userName  String
  content   String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model StageApproval {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  userName    String
  status      String   // APPROVED / REJECTED
  comment     String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

// 项目接手申请
// - 3个月保护期内：status=PENDING 等待原维护人审批
// - 3个月保护期外：status=AUTO_COMPLETED 直接变更维护人
model TakeoverRequest {
  id              String   @id @default(cuid())
  projectId       String
  requesterId     String   // 发起接手的用户
  currentOwnerId  String   // 当前维护人
  status          String   @default("PENDING") // PENDING / APPROVED / REJECTED / AUTO_COMPLETED
  comment         String?  // 请求者留言
  reviewerComment String?  // 审批人留言
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reviewedAt      DateTime? // 审批时间

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester       User     @relation("TakeoverRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  currentOwner    User     @relation("TakeoverRequestOwner", fields: [currentOwnerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([requesterId])
  @@index([currentOwnerId])
  @@index([status])
}

// 阶段变更请求（需投资合伙人审批）
// 仅以下两种变更需审批：
// 1. 从 INITIAL_TALK 或 PRE_DD → PROJECT_INITIATION（立项）
// 2. 从 DUE_DILIGENCE → CLOSING（交割）
model StageChangeRequest {
  id          String   @id @default(cuid())
  projectId   String
  requesterId String   // 发起阶段变更的维护人
  reviewerId  String?  // 审批的投资合伙人
  fromStage   String   // 变更前阶段
  toStage     String   // 变更后阶段
  status      String   @default("PENDING") // PENDING / APPROVED / REJECTED
  comment     String?  // 发起者留言
  reviewerComment String? // 审批者留言
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester   User     @relation("StageChangeRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer    User?    @relation("StageChangeRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([requesterId])
}

// 新闻监控：融资新闻文章
model NewsArticle {
  id          String   @id @default(cuid())
  title       String   // 文章标题
  source      String   // 来源（如 36氪、投资界、量子位等）
  sourceUrl   String?  // 原文链接
  industry    String   // 所属行业赛道
  summary     String   // 摘要（卡片展示用）
  content     String   // 详细内容
  author      String?  // 作者
  publishedAt DateTime // 发布时间
  weekStart   DateTime // 所属周的开始时间（周一12:00），用于按周筛选
  createdAt   DateTime @default(now())

  @@index([industry])
  @@index([publishedAt])
  @@index([weekStart])
  @@index([source])
}

// 新闻监控：自定义关注关键字
model NewsKeyword {
  id        String   @id @default(cuid())
  keyword   String   @unique
  createdAt DateTime @default(now())
}

// 新闻监控：自定义关注文章来源
model NewsSource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════
// 投研分析模块
// ════════════════════════════════════════════════════════

// 投研分析模块（每项目 9 个模块行）
// moduleType 取值：
//   INDUSTRY        - 行业分析（行业发展阶段、TRL 技术成熟度）
//   PRODUCT_TECH    - 产品和技术
//   COMPETITION     - 竞争分析（产品定位/市场策略/业务进展/团队背景）
//   BUSINESS_DD     - 业务尽调（前十大客户/已签订单/意向订单/客户评价）
//   FINANCIAL_DD    - 财务尽调
//   TEAM            - 核心团队
//   COMPANY         - 公司概况
//   FINANCING       - 融资规划和进展（手动：融资金额/投前估值/老股估值/其它机构进展/核心条款）
//   RECOMMENDATION  - 投资建议（手动：投资金额区间/领投或跟投）
model ResearchModule {
  id            String   @id @default(cuid())
  projectId     String
  moduleType    String   // 9 种模块类型
  content       String?  // JSON 字符串：手动输入的结构化数据
  aiJson        String?  // JSON 字符串：DeepSeek 分析结果
  aiSummary     String?  // 文本摘要
  analyzedAt    DateTime? // 最近一次 AI 分析时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents     ResearchDocument[]
  comments      ResearchComment[]

  @@unique([projectId, moduleType])
  @@index([projectId])
  @@index([moduleType])
}

// 投研分析模块文档（Word/Excel/PPT/PDF）
// - 每个模块独立上传文档
// - 上传时同步提取文本内容（extractedText），供 DeepSeek 分析
model ResearchDocument {
  id            String   @id @default(cuid())
  moduleId      String
  fileName      String   // 原始文件名（展示用）
  fileUrl       String   // 文件访问 URL
  fileType      String   // MIME 类型
  fileSize      Int      // 文件大小（字节）
  extractedText String?  // 从文档提取的文本内容（供 AI 分析）
  uploadedById  String
  createdAt     DateTime @default(now())

  module        ResearchModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([uploadedById])
}

// 投研分析模块点评（含回复）
// - 一级点评：parentId 为空，直接对模块内容进行标注点评
// - 回复：parentId 指向一级点评，仅主维护人/辅助维护人可回复
// - quoteText/quoteField：可视化报告页框选提问的锚点（被选中的原文 + 所属字段标识）
model ResearchComment {
  id          String   @id @default(cuid())
  moduleId    String   // 关联的 ResearchModule
  userId      String   // 发布人
  parentId    String?  // 父点评 ID（为空表示一级点评；非空表示回复）
  content     String   // 点评/回复内容
  quoteText   String?  // 框选提问：被选中的原文内容
  quoteField  String?  // 框选提问：内容所属字段标识（如 "INDUSTRY.summary"）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      ResearchModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      ResearchComment? @relation("ResearchCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ResearchComment[] @relation("ResearchCommentReplies")

  @@index([moduleId])
  @@index([userId])
  @@index([parentId])
}

// ═══════════════════════════════════════════════════════════
// 尽调报告（DeepSeek Harness 架构）
// 项目进入尽调阶段自动触发：框架生成 → 并行子Agent模块分析 → 缺口清单
// ═══════════════════════════════════════════════════════════
model DDReport {
  id            String   @id @default(cuid())
  projectId     String   @unique
  frameworkJson String?  // 定制化尽调框架 JSON（7大必选模块 + AI定制项 + 关注点）
  status        String   @default("PENDING") // PENDING / RUNNING / COMPLETED / FAILED
  gapsJson      String?  // 缺口清单汇总 JSON：[{moduleKey, moduleName, missing}]
  lastRunAt     DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleResults DDModuleResult[]
}

// 尽调模块分析结果（每个模块一个子Agent的产出）
model DDModuleResult {
  id            String   @id @default(cuid())
  reportId      String
  moduleKey     String   // 模块标识：mainProducts / coreTeam / custom:xxx
  moduleName    String   // 中文名称
  required      Boolean  @default(true) // 是否7大必选模块
  status        String   @default("PENDING") // PENDING / RUNNING / COMPLETED / INSUFFICIENT_DATA / FAILED
  conclusion    String?  // 分析结论
  citationsJson String?  // 引用来源 JSON：[{label, url}]（来自子Agent的web_search会话日志，已交叉验证）
  missing       String?  // 缺少的资料说明（INSUFFICIENT_DATA 时，供维护人补充）
  inputHash     String?  // 输入指纹（增量重跑：输入未变且已完成则跳过）
  analyzedAt    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report        DDReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, moduleKey])
  @@index([reportId])
}

// ═══════════════════════════════════════════════════════════
// 尽调工作台（《项目尽调模块优化技术规划与执行方案》P0）
// 以尽调批次为底座：批次 → 九大模块任务 → 证据片段 → 报告版本（冻结）
// 闭环：资料上传—结构化抽取—证据引用—模块报告—整包投委会报告
// ═══════════════════════════════════════════════════════════

// 尽调批次：一个项目可有多批尽调（如 Pre-A 轮、A 轮）
// 每批按模板版本生成独立任务与报告版本；仅冻结版本可进入投委会材料
model DDBatch {
  id              String    @id @default(cuid())
  projectId       String
  round           String?   // 融资轮次（如 "A轮"、"Pre-A"，空=不限）
  templateVersion String    @default("v1") // 生成任务所用的模板版本
  status          String    @default("IN_PROGRESS") // IN_PROGRESS / IN_REVIEW / FROZEN
  initiatedById   String    // 发起人
  dueDate         DateTime? // 尽调截止日
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiatedBy    User               @relation("DDBatchInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  tasks          DDTask[]
  evidences      DDEvidence[]
  reportVersions DDReportVersion[]

  @@index([projectId])
  @@index([status])
}

// 模块任务：按模板 v1 生成的九大尽调模块
// 驱动完成度（状态+结论+红旗），不以"有文字"替代"完成"
model DDTask {
  id           String   @id @default(cuid())
  batchId      String
  moduleKey    String   // 模板模块标识（src/lib/dd-workbench/template.ts）
  status       String   @default("PENDING") // PENDING / IN_PROGRESS / IN_REVIEW / DONE / BLOCKED
  conclusion   String?  // 人工结论（进入正式报告；冻结时随快照固化）
  aiDraft      String?  // AI 草稿（仅供人工参考，不直接进入正式结论）
  ownerId      String?  // 负责人（模板建议责任可被重新分配）
  redFlagLevel String   @default("NONE") // NONE / MEDIUM / HIGH
  sortKey      Int      @default(0) // 展示顺序（模板顺序）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batch      DDBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  owner      User?        @relation("DDTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  evidences  DDEvidence[]

  @@unique([batchId, moduleKey])
  @@index([batchId])
  @@index([ownerId])
}

// 证据片段：事实与结论的可追溯来源（证据链核心对象）
// - sourceType=DOCUMENT：引用项目资料（documentId + location 定位页码/段落）
// - sourceType=WEB：外部链接（sourceUrl + 创建时间即抓取时间记录）
// - sourceType=MANUAL：访谈/口述（一手陈述，等级固定为 B）
// 等级 A 原始或权威 / B 一手陈述 / C 可信二手 / D 待核验（D 不得支撑关键结论）
model DDEvidence {
  id            String    @id @default(cuid())
  batchId       String
  taskId        String
  sourceType    String    // DOCUMENT / WEB / MANUAL
  documentId    String?   // 引用的项目资料（ProjectDocument.id；不建外键，资料删除后证据保留溯源编号）
  sourceUrl     String?   // WEB 来源链接
  sourceLabel   String?   // 来源名称（如 "审计报告"、"36氪报道"、"创始人访谈"）
  location      String?   // 定位：页码/章节/段落（如 "P12 第3节"）
  excerpt       String    // 摘录原文（结论必须可定位到此处）
  grade         String    @default("C") // A / B / C / D
  status        String    @default("PENDING") // PENDING / CONFIRMED / CONFLICT
  note          String?   // 冲突说明 / 备注补充
  createdById   String
  confirmedById String?   // 确认人（人工复核留痕）
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  batch       DDBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  task        DDTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User    @relation("DDEvidenceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  confirmedBy User?   @relation("DDEvidenceConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([taskId])
  @@index([documentId])
}

// 报告版本：冻结快照（不可静默修改）
// 仅 FROZEN 版本可进入投委会材料库；每次冻结版本号批次内自增
model DDReportVersion {
  id          String   @id @default(cuid())
  batchId     String
  reportType  String   // FULL_PACKAGE（整包）/ MODULE（单模块）
  moduleKey   String?  // MODULE 类型时的模块标识
  version     Int      @default(1) // 批次内自增版本号
  contentJson String   // 冻结快照：模块结论 + 证据索引 + 红旗 + 未决问题 + 进度
  frozenById  String
  frozenAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  batch     DDBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  frozenBy  User    @relation("DDReportFreezer", fields: [frozenById], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([reportType])
}

// ═══════════════════════════════════════════════════════════
// 项目解读（AI行研 · 固定分析框架模板）
// 上传项目文档 → 七维解读（市场地位/技术领先性/团队咖位/竞争/创业窗口/
// 市场地位预估/10条行业融资案例）+ 问题清单（15-20问、10+技术问题、
// 每题带行业与技术视角的理想答案）→ 逐题上传访谈文件闭环校验 → 综合结论
// ═══════════════════════════════════════════════════════════

model ProjectInterpretation {
  id                 String   @id @default(cuid())
  userId             String
  projectName        String   // 项目名（用户填写或 AI 从文档推断）
  fileName           String   // 原始文件名
  fileUrl            String   // 文件访问 URL
  fileType           String   // MIME 类型
  fileSize           Int      // 字节
  documentText       String?  // 上传时提取的文档文本（供 AI 分析）
  status             String   @default("UPLOADED") // UPLOADED / INTERPRETING / INTERPRETED / FAILED
  interpretationJson String?  // 七维解读结果（固定模板结构）
  questionsStatus    String   @default("PENDING") // PENDING / GENERATING / READY / FAILED
  conclusionJson     String?  // 综合分析结论（访谈校验后生成）
  // 批量访谈校验：整个项目只上传一次访谈纪要，自动校验全部问题
  verifyStatus       String   @default("PENDING") // PENDING / RUNNING / DONE / FAILED
  interviewFileName  String?  // 访谈纪要文件名（音频或文档）
  interviewFileUrl   String?  // 访谈纪要文件 URL
  interviewText      String?  // 本次校验使用的访谈全文（文档提取/音频转写粘贴）
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User                     @relation("ProjectInterpretations", fields: [userId], references: [id], onDelete: Cascade)
  questions  InterpretationQuestion[]

  @@index([userId])
}

// 解读问题清单条目（每题带理想答案 + 访谈校验结果）
model InterpretationQuestion {
  id               String   @id @default(cuid())
  interpretationId String
  order            Int      // 展示顺序
  category         String   // TECH / MARKET / TEAM / BUSINESS / FINANCE
  question         String   // 必须提问的问题
  idealAnswer      String   // 行业与技术视角的理想答案（前端浅色字体显示）
  verifyStatus     String   @default("PENDING") // PENDING / VERIFIED
  verifyFileName   String?  // 访谈文件名（音频或文档）
  verifyFileUrl    String?  // 访谈文件 URL
  verifyText       String?  // 访谈内容文本（文档自动提取 / 音频转写粘贴）
  verifyResultJson String?  // 校验结果：{ matchLevel, gapAnalysis, conclusion }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  interpretation   ProjectInterpretation @relation(fields: [interpretationId], references: [id], onDelete: Cascade)

  @@index([interpretationId])
}

// ═══════════════════════════════════════════════════════════
// AI行研 ChatBot（Harness 架构 + 分层记忆）
// ═══════════════════════════════════════════════════════════

// AI行研会话（按用户隔离）
model AIChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("新对话")  // 自动从首条提问生成
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIChatMessage[]

  @@index([userId])
  @@index([updatedAt])
}

// AI行研消息
model AIChatMessage {
  id            String   @id @default(cuid())
  sessionId     String
  role          String   // user / assistant
  content       String
  // 引用来源 JSON：[{label, url}]（内部项目库来源 + 联网来源）
  sourcesJson   String?
  // 内部命中的项目库信息 JSON：[{projectId, projectName, followStage}]（溯源用）
  projectsJson  String?
  createdAt     DateTime @default(now())
  session       AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// AI 分层记忆库（Mem0 式，全局共享的事实层）
// - type=FACT    语义记忆：结构化事实（金额/日期/结论/偏好），同主体同字段新覆盖旧
// - type=EPISODE 情景记忆：每轮对话的一句摘要（会话级，回溯用）
model AIMemory {
  id          String    @id @default(cuid())
  type        String    @default("FACT")  // FACT / EPISODE
  scope       String    @default("global") // global（全局共享）/ session:<id>
  // 事实主体（公司名/行业/用户偏好标识等），FACT 必填
  subject     String?
  // 事实字段名（如 fundingRound/valuation/时间窗口判断），用于冲突覆盖
  field       String?
  content     String    // 记忆内容（一句话，≤200字）
  // 召回用关键词（空格分隔，提取时由 LLM 生成或程序分词）
  keywords    String    @default("")
  importance  Int       @default(3) // 1-5，重要度（融资事件=5，闲聊=1）
  superseded  Boolean   @default(false) // 被新事实覆盖后标记，不物理删除
  sourceSessionId String? // 来源会话
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, superseded])
  @@index([subject, field, superseded])
  @@index([importance])
}
